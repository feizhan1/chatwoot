# Docker Build 配置文件
# 复制此文件为 .env.build 并填入实际值

# Docker Hub 配置
# 你的 Docker Hub 用户名
DOCKER_USERNAME=zhanfei

# Docker Hub 仓库名称（通常与项目名相同）
DOCKER_REPOSITORY=tvcmall-stage-build-chatwoot

# 完整的镜像名称（会自动组合为: username/repository）
# 例如: johndoe/chatwoot-custom
DOCKER_IMAGE=${DOCKER_USERNAME}/${DOCKER_REPOSITORY}

# 镜像标签配置
# 默认标签（通常使用 latest）
DOCKER_TAG=latest

# 是否同时推送 Git commit hash 作为标签（true/false）
PUSH_GIT_TAG=true

# 是否同时推送版本号标签（如果设置了版本号）
# 例如: v1.0.0, v1.0.1
VERSION_TAG=

# 构建参数
# Rails 环境
RAILS_ENV=production

# Node 环境
NODE_ENV=production

# 是否启用静态文件服务
RAILS_SERVE_STATIC_FILES=true

# Bundle 排除的组（开发和测试）
BUNDLE_WITHOUT=development:test

# 构建平台（可选，用于多平台构建）
# 例如: linux/amd64,linux/arm64
DOCKER_PLATFORM=linux/amd64

# 是否使用 BuildKit（推荐，提升构建速度）
DOCKER_BUILDKIT=1

# 构建缓存配置（可选）
# 设置为 true 启用内联缓存，加速后续构建
USE_CACHE=true
