# Chatwoot 数据库备份服务 Dockerfile
FROM alpine:3.18

# 安装必要的包
RUN apk add --no-cache \
    bash \
    postgresql-client \
    python3 \
    py3-pip \
    curl \
    gzip \
    coreutils \
    tzdata \
    && pip3 install --no-cache-dir awscli

# 设置时区
ENV TZ=Asia/Shanghai
RUN cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime

# 创建应用目录
WORKDIR /app

# 创建备份用户
RUN addgroup -g 1000 backup && \
    adduser -D -s /bin/bash -u 1000 -G backup backup

# 创建必要的目录
RUN mkdir -p /app/scripts /app/logs /tmp/backups && \
    chown -R backup:backup /app /tmp/backups

# 复制备份脚本
COPY scripts/backup/backup-to-s3.sh /app/scripts/
COPY scripts/backup/backup-entrypoint.sh /app/scripts/
COPY scripts/backup/backup-cron.sh /app/scripts/
COPY scripts/backup/backup-scheduler.sh /app/scripts/

# 设置权限
RUN chmod +x /app/scripts/*.sh && \
    chown -R backup:backup /app/scripts

# 切换到备份用户
USER backup

# 入口点
ENTRYPOINT ["/app/scripts/backup-entrypoint.sh"]

# 默认命令 - 运行 cron 守护进程
CMD ["cron"]